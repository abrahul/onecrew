# Set the real ONECREW WhatsApp number in international format, digits only.
DATABASE_URL=postgresql://onecrew:change-me@localhost:5432/onecrew?schema=public
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_BUSINESS_HOURS=Monday – Saturday, 8:00 AM – 8:00 PM
NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata
ADMIN_EMAIL=admin@example.com
# Set ADMIN_PASSWORD in the deployment environment. Use a unique password of at least 14 characters.
# Storage: local disk in development, database-backed on Vercel, or Cloudflare R2 when configured
PRIVATE_UPLOAD_DIR=./private-uploads
# Optional Cloudflare R2 storage (takes precedence over the other storage backends)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

WHATSAPP_PROVIDER=mock
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Choose a supported Graph API version from your Meta app dashboard (for example v23.0).
META_GRAPH_API_VERSION=
ONECREW_PAYMENT_QR_URL=

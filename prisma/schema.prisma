generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  CONFIRMED
  ASSIGNED
  WORKER_ON_THE_WAY
  WORK_STARTED
  WORK_COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  REFUNDED
}

enum WorkerType {
  SKILLED_WORKER
  GENERAL_LABOUR
  TEMPORARY_WORKER
  EMERGENCY_WORKER
  OTHER
}

enum WorkerStatus {
  AVAILABLE
  BUSY
  OFFLINE
  INACTIVE
}

enum ApplicationStatus {
  NEW
  REVIEWING
  CONTACTED
  APPROVED
  REJECTED
}

enum WhatsAppConversationState { START CATEGORY_SELECTION SERVICE_SELECTION LOCATION DATE TIME WORKER_COUNT DURATION REQUIREMENTS SUMMARY PRICE_CONFIRMATION PAYMENT_PENDING PAYMENT_SUBMITTED HUMAN_SUPPORT COMPLETED CANCELLED }
enum WhatsAppMessageDirection { INBOUND OUTBOUND }
enum WhatsAppMessageType { TEXT BUTTONS LIST IMAGE TEMPLATE SYSTEM }

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     Booking[] @relation("BookingCreator")
  assignments  Booking[] @relation("BookingAssigner")
  paymentVerifications Booking[] @relation("PaymentVerifier")
  statusChanges BookingStatusHistory[]
  auditLogs    AuditLog[]
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([adminId, expiresAt])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  whatsapp  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
  whatsappConversations WhatsAppConversation[]
}

model WhatsAppConversation {
  id String @id @default(cuid())
  phone String @unique
  customerName String?
  customerId String?
  customer Customer? @relation(fields:[customerId], references:[id])
  state WhatsAppConversationState @default(START)
  category String?
  service String?
  location String?
  date String?
  time String?
  duration String?
  numberOfWorkers Int?
  requirements String?
  estimatedAmount Int?
  paymentStatus String?
  lastMessageAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages WhatsAppMessage[]
  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id String @id @default(cuid())
  conversationId String
  conversation WhatsAppConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  providerMessageId String? @unique
  direction WhatsAppMessageDirection
  messageType WhatsAppMessageType @default(TEXT)
  content String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
}

model MockWhatsAppEvent {
  id String @id @default(cuid())
  phone String
  eventType String
  payload Json
  processed Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}

model Service {
  id        String   @id @default(cuid())
  category  String
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  bookings  Booking[]
}

model Worker {
  id           String      @id @default(cuid())
  fullName     String
  phone        String
  whatsapp     String
  profilePhoto String?
  workerType   WorkerType
  skills       String[]
  experience   Int?
  serviceAreas String[]
  availability String
  status       WorkerStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  bookings     Booking[]
  convertedApplications CareerApplication[]
  @@index([status, workerType])
}

model Booking {
  id                   String        @id @default(cuid())
  bookingNumber        String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  serviceId            String
  service              Service       @relation(fields: [serviceId], references: [id])
  assignedWorkerId     String?
  assignedWorker       Worker?       @relation(fields: [assignedWorkerId], references: [id])
  status               BookingStatus @default(CONFIRMED)
  paymentStatus        PaymentStatus
  amount               Decimal       @db.Decimal(12, 2)
  paymentReference     String?
  paymentNotes         String?
  paymentVerifiedById  String?
  paymentVerifiedBy    AdminUser?    @relation("PaymentVerifier", fields: [paymentVerifiedById], references: [id])
  paymentVerifiedAt    DateTime?
  address              String
  area                 String
  mapLink              String?
  serviceDate          DateTime @db.Date
  serviceTime          String
  duration             String
  numberOfWorkers      Int
  requirements         String
  trackingToken        String        @unique
  createdById          String
  createdBy            AdminUser     @relation("BookingCreator", fields: [createdById], references: [id])
  assignedById         String?
  assignedBy           AdminUser?    @relation("BookingAssigner", fields: [assignedById], references: [id])
  assignedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  statusHistory        BookingStatusHistory[]
  @@index([serviceDate, status])
  @@index([paymentStatus, status])
  @@index([customerId])
  @@index([assignedWorkerId])
}

model BookingStatusHistory {
  id           String        @id @default(cuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStatus BookingStatus?
  newStatus    BookingStatus
  changedById  String
  changedBy    AdminUser     @relation(fields: [changedById], references: [id])
  timestamp    DateTime      @default(now())
  @@index([bookingId, timestamp])
}

model CareerApplication {
  id               String            @id @default(cuid())
  fullName         String
  phone            String
  whatsapp         String
  email            String?
  location         String
  workerType       WorkerType
  primarySkill     String
  experience       Int?
  preferredArea    String?
  availability     String
  previousExperience String?
  languages        String?
  additionalSkills String?
  status           ApplicationStatus @default(NEW)
  convertedWorkerId String?          @unique
  convertedWorker  Worker?           @relation(fields: [convertedWorkerId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  files            ApplicationFile[]
  @@index([status, createdAt])
}

model ApplicationFile {
  id            String            @id @default(cuid())
  applicationId String
  application   CareerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  originalName  String
  storageName   String            @unique
  mimeType      String
  size          Int
  createdAt     DateTime          @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  attemptedAt DateTime @default(now())
  succeeded Boolean  @default(false)
  @@index([ipHash, attemptedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
  @@index([adminId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
